diff --git a/sys/os/init_main.c b/sys/os/init_main.c
index 1c6bf2a..f1a0aa4 100644
--- a/sys/os/init_main.c
+++ b/sys/os/init_main.c
@@ -466,6 +466,15 @@ idlework()
 			delay = 1000;
 		}

+#ifdef QEMU_IDLE_POWERDOWN
+		if (!whichqs
+#ifdef LWP
+		    && !__Nrunnable
+#endif LWP
+		    && !qrunflag)
+			__asm__ __volatile__(".word 0xa7800000");
+#endif QEMU_IDLE_POWERDOWN
+
 #if defined(SAS)
 		if (!whichqs)
 			mpsas_idle_trap();
