diff --git a/sys/sun4m/swtch.s b/sys/sun4m/swtch.s
index a1ab804..320d5c8 100644
--- a/sys/sun4m/swtch.s
+++ b/sys/sun4m/swtch.s
@@ -248,6 +248,16 @@ _testq:
 	ldub	[%g1 + %lo(_qrunflag)], %g1
 	tst	%g1
 #ifndef SAS
+#ifdef QEMU_IDLE_POWERDOWN
+	! Only enter POWERDOWN when no stream work is pending.
+	bnz	qemu_idle_runqueues
+	nop
+	wr	%g0, %g0, %asr19
+	b	_idle
+	nop
+qemu_idle_runqueues:
+#else
 	bz	_idle			! no
 	nop
+#endif QEMU_IDLE_POWERDOWN
 #else	SAS
